RewriteRule ^category/ https://satingraphic.ca/satin/print-shop/? [R=301,L,NC]
RewriteRule ^(post|blog)/ https://satingraphic.ca/satin/guides/? [R=301,L,NC]

# root of the live domain: straight to the canonical /satin/ (one hop from http:// and www.)
RewriteCond %{HTTP_HOST} ^(www\.)?satingraphic\.ca(:[0-9]+)?$ [NC]
RewriteRule ^$ https://satingraphic.ca/satin/ [R=301,L]

# staging hostname retired: pages and admin 301 to the live domain (only the API keeps answering, for open sessions)
RewriteCond %{HTTP_HOST} ^new\.satingraphic\.ca(:[0-9]+)?$ [NC]
RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$
RewriteRule !^(api/|api\.php) https://satingraphic.ca%{REQUEST_URI} [R=301,L]

# canonical origin: https and no www (X-Forwarded-Proto guard for proxies/CDNs)
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]
RewriteCond %{HTTPS} off
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# the site lives under /satin/: a real 301 instead of the meta refresh in /index.html
RewriteRule ^$ /satin/ [R=301,L]

# IndexNow key file (key set in Admin → Business info & SEO; answered by api.php)
RewriteRule ^[a-f0-9]{32}\.txt$ api.php [L]

# API and admin
RewriteRule ^api/ api.php [L,QSA]
RewriteRule ^sitemap\.xml$ api.php [L]
RewriteRule ^admin$ /admin/ [R=301,L]

# Our Work project pages: admin-added ones (no static file) and shipped ones with the owner's renames (portfolio.php)
RewriteRule ^satin/(?:(?:fa|fr|es)/)?portfolio/projects/[a-z0-9-]+/?$ api.php [L,QSA]

# checkout page (the Worker served /checkout/index.html for /satin/checkout and its language variants)
RewriteRule ^satin/(?:(?:fa|fr|es)/)?checkout/?$ checkout/index.html [L]

# Our Work data: the shipped list + Admin → Our Work renames (portfolio.php)
RewriteRule ^cms/portfolio-data\.mjs$ api.php [L]

# external images (supplier/Google photos) live on our host: a file not copied yet is fetched once by api.php (ext_images.php)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^satin/img/ext/[0-9a-f]{16}\.(?:jpe?g|png|webp|gif|svg|avif)$ api.php [L]

# optimized images (same map as the original Worker)
RewriteRule ^satin/img/automotive-detailing\.png$ satin/img/automotive-detailing.optimized.webp [L]
RewriteRule ^satin/img/car-red-1100\.webp$ satin/img/car-red.optimized.webp [L]
