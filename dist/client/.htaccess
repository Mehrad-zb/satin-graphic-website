Options -Indexes
DirectoryIndex index.html
AddType text/javascript .mjs .js
AddType image/webp .webp
AddType font/woff2 .woff2
AddType image/svg+xml .svg
AddType application/json .json
AddType application/manifest+json .webmanifest
AddType text/plain .txt
AddDefaultCharset utf-8

# compression: Brotli when the server has it, otherwise gzip
<IfModule mod_brotli.c>
AddOutputFilterByType BROTLI_COMPRESS text/html text/css text/plain text/xml text/javascript application/javascript application/json application/xml application/ld+json image/svg+xml
</IfModule>
<IfModule !mod_brotli.c>
<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml text/javascript application/javascript application/json application/xml application/ld+json image/svg+xml
</IfModule>
</IfModule>

# the staging hostname is never indexed, even when it shares this docroot with the live domain
SetEnvIfNoCase Host "^new\.satingraphic\.ca(:[0-9]+)?$" SATIN_STAGING_HOST

<IfModule mod_headers.c>
Header always set X-Content-Type-Options nosniff
Header always set Referrer-Policy strict-origin-when-cross-origin
Header always set X-Robots-Tag "noindex, nofollow" env=SATIN_STAGING_HOST
<FilesMatch "\.html$">
Header set Cache-Control "no-cache"
</FilesMatch>
<FilesMatch "\.(css|mjs|js|json)$">
Header set Cache-Control "public, max-age=600"
</FilesMatch>
<FilesMatch "\.(png|jpe?g|webp|avif|svg|gif|mp4|ico)$">
Header set Cache-Control "public, max-age=604800"
</FilesMatch>
<FilesMatch "\.woff2$">
Header set Cache-Control "public, max-age=2592000"
</FilesMatch>
<FilesMatch "^(robots\.txt|llms(-full)?\.txt|sitemap\.xml)$">
Header set Cache-Control "public, max-age=3600"
</FilesMatch>
# customer app: service workers and the web app manifest are always revalidated (a deploy is live at once)
<FilesMatch "^(sw\.js|manifest\.webmanifest|manifest\.json)$">
Header set Cache-Control "no-cache"
</FilesMatch>
# app links for the store apps: Android (assetlinks.json) and iOS (apple-app-site-association, no file extension)
<FilesMatch "^(assetlinks\.json|apple-app-site-association)$">
Header set Cache-Control "public, max-age=3600"
</FilesMatch>
# CSS/JS/JSON referenced with a content hash (?v=…, added by seo_pass.py) never change: cache for a year
<If "%{QUERY_STRING} =~ /(^|&)v=[0-9a-f]{8,}(&|$)/">
Header set Cache-Control "public, max-age=31536000, immutable"
</If>
</IfModule>

<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType text/html "access plus 0 seconds"
ExpiresByType image/webp "access plus 7 days"
ExpiresByType image/jpeg "access plus 7 days"
ExpiresByType image/png "access plus 7 days"
ExpiresByType image/svg+xml "access plus 7 days"
ExpiresByType font/woff2 "access plus 30 days"
</IfModule>

RewriteEngine On

# AutoSSL / ACME domain validation must reach its file over plain http, before any redirect
RewriteRule ^\.well-known/(acme-challenge|pki-validation)/ - [L]
# store app verification files: served as-is as JSON, never redirected (Google and Apple do not follow redirects)
<Files "apple-app-site-association">
ForceType application/json
</Files>
RewriteRule ^\.well-known/(assetlinks\.json|apple-app-site-association)$ - [L]

# old Wix URLs (274 mapped in data/old-site-redirects.json + catch-alls); "?" drops Wix query strings
