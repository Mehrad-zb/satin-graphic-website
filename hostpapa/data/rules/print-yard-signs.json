{"rule":{"id":"print-yard-signs","label":"Yard Signs","path":"/satin/print-shop/large-format/yard-signs","fields":[{"key":"quantity","label":"Quantity","type":"number","default":1,"min":1,"max":10000,"step":1},{"key":"size","label":"Size","type":"select","default":0,"options":[{"label":"18 × 24 in","value":0},{"label":"24 × 36 in","value":1}]},{"key":"print_sides","label":"Print sides","type":"select","default":0,"options":[{"label":"Single side","value":0},{"label":"Double side","value":1}]},{"key":"hardware","label":"Hardware","type":"select","default":1,"options":[{"label":"H-stakes included","value":0},{"label":"No stakes","value":1}]},{"key":"design","label":"Design services","type":"checkbox","default":0}],"constants":{"designFee":100,"baseq1":19.99,"baseq2":30.4,"baseq5":73.6,"baseq10":145.6,"baseq25":280,"largerSize":9,"backSide":4,"stake":2,"unit1":19.99,"unit2":15.2,"unit5":14.719999999999999,"unit10":14.559999999999999,"unit25":11.2},"formula":"(quantity * if(quantity < 2, unit1, if(quantity < 5, unit2, if(quantity < 10, unit5, if(quantity < 25, unit10, unit25))))) + quantity * (size * largerSize + print_sides * backSide + (1 - hardware) * stake) + design * designFee","deposit":{"type":"percent","value":100},"discount":{"type":"percent","value":0},"taxPercent":13,"revision":0,"constantLabels":{"designFee":"Optional design services","baseq1":"Yard Signs · 1 units","baseq2":"Yard Signs · 2 units","baseq5":"Yard Signs · 5 units","baseq10":"Yard Signs · 10 units","baseq25":"Yard Signs · 25 units","largerSize":"Larger size per unit · Satin allowance","backSide":"Double-sided print per unit · Satin allowance","stake":"H-stake per unit · Satin allowance"},"priceOnRequest":true,"priceNote":"","pricingVersion":1,"updateVersion":4}}