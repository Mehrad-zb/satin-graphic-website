{"rule":{"id":"apparel-t-shirts","label":"T-Shirts","path":"/satin/apparel/t-shirts","fields":[{"key":"quantity","label":"Quantity","type":"number","default":1,"min":1,"max":10000,"step":1},{"key":"method","label":"Decoration method","type":"select","default":1.15,"options":[{"label":"DTF","value":1.15},{"label":"Vinyl Heat Press","value":1.1}]},{"key":"size","label":"Size","type":"select","default":0,"options":[{"label":"XS","value":0},{"label":"S","value":1},{"label":"M","value":2},{"label":"L","value":3},{"label":"XL","value":4},{"label":"2XL","value":5},{"label":"3XL","value":6}]},{"key":"colour","label":"Colour","type":"select","default":0,"options":[{"label":"Black","value":0},{"label":"White","value":1},{"label":"Heather Grey","value":2},{"label":"Navy","value":3},{"label":"Forest","value":4},{"label":"Maroon","value":5},{"label":"Safety Green","value":6}]},{"key":"design","label":"Design services","type":"checkbox","default":0}],"constants":{"unitPrice":17.99,"designFee":30,"designDeposit":30},"formula":"unitPrice * quantity * method * if(quantity > 20, 0.95, 1) + design * designFee","taxPercent":13,"deposit":{"type":"percent","value":100},"discount":{"type":"percent","value":0},"revision":0,"updateVersion":4}}