{"rule":{"id":"wrap-trailer","label":"Trailer wrap estimator","path":"/satin/vehicle-wraps/estimator/trailer","fields":[{"key":"vehicle_0","label":"Trailer length","type":"select","default":1,"options":[{"label":"12–24 ft","value":1}]},{"key":"vehicle_1","label":"Front style","type":"select","default":1,"options":[{"label":"Flat","value":1},{"label":"V-nose","value":1.06}]},{"key":"vehicle_2","label":"Coverage area","type":"select","default":1,"options":[{"label":"Sides only","value":1},{"label":"Rear + Sides","value":1.12},{"label":"Front + Sides","value":1.12}]},{"key":"coverage","label":"Wrap coverage","type":"select","default":1,"options":[{"label":"Decals + Lettering","value":0.22},{"label":"Partial wrap · rear half","value":0.45},{"label":"¾ wrap · rear to front","value":0.7},{"label":"Full Wrap","value":1}]},{"key":"finish","label":"Finish","type":"select","default":1,"options":[{"label":"Gloss","value":1},{"label":"Matte","value":1.12},{"label":"Satin","value":1.12}]},{"key":"material","label":"Material","type":"select","default":1.08,"options":[{"label":"3M","value":1.08}]},{"key":"roof","label":"Include roof","type":"checkbox","default":0},{"key":"design","label":"Design service","type":"checkbox","default":0}],"constants":{"base":4800,"roofMultiplier":1.12,"designDeposit":250,"fullWrapFactor":0.9},"formula":"round((base * vehicle_0 * vehicle_1 * vehicle_2 * coverage * finish * material * if(roof, roofMultiplier, 1)) * if(coverage == 1, fullWrapFactor, 1) / 10) * 10 + if(design, designDeposit, 0)","deposit":{"type":"percent","value":50},"discount":{"type":"percent","value":0},"taxPercent":13,"revision":0,"updateVersion":4,"priceOnRequest":false}}