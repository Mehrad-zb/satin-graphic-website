{"rule":{"id":"wrap-bus","label":"Bus wrap estimator","path":"/satin/vehicle-wraps/estimator/bus","fields":[{"key":"vehicle_0","label":"Bus type","type":"select","default":1,"options":[{"label":"School","value":1},{"label":"Shuttle","value":0.92},{"label":"Coach","value":1.12}]},{"key":"vehicle_1","label":"Dimensions","type":"select","default":1,"options":[{"label":"20–30 ft","value":1},{"label":"30–40 ft","value":1.25},{"label":"40+ ft","value":1.5}]},{"key":"vehicle_2","label":"Window coverage","type":"select","default":1,"options":[{"label":"None","value":1},{"label":"Perforated graphics","value":1.1}]},{"key":"coverage","label":"Wrap coverage","type":"select","default":1,"options":[{"label":"Decals + Lettering","value":0.22},{"label":"Partial wrap · rear half","value":0.45},{"label":"¾ wrap · rear to front","value":0.7},{"label":"Full Wrap","value":1}]},{"key":"finish","label":"Finish","type":"select","default":1,"options":[{"label":"Gloss","value":1},{"label":"Matte","value":1.12},{"label":"Satin","value":1.12}]},{"key":"material","label":"Material","type":"select","default":1.08,"options":[{"label":"3M","value":1.08}]},{"key":"roof","label":"Include roof","type":"checkbox","default":0},{"key":"design","label":"Design service","type":"checkbox","default":0}],"constants":{"base":8500,"roofMultiplier":1.12,"designDeposit":250,"fullWrapFactor":0.9},"formula":"round((base * vehicle_0 * vehicle_1 * vehicle_2 * coverage * finish * material * if(roof, roofMultiplier, 1)) * if(coverage == 1, fullWrapFactor, 1) / 10) * 10 + if(design, designDeposit, 0)","deposit":{"type":"percent","value":50},"discount":{"type":"percent","value":0},"taxPercent":13,"revision":0,"updateVersion":4,"priceOnRequest":false,"priceNote":"Vehicle pricing is confirmed by our team."}}