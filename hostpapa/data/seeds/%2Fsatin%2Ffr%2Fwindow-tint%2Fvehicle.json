{"rule":{"id":"tint-vehicle","label":"Vehicle window tint","path":"/satin/window-tint/vehicle","fields":[{"key":"vehicle","label":"Vehicle","type":"select","default":249,"options":[{"label":"Sedan / Coupe","value":249},{"label":"SUV / Crossover","value":289},{"label":"Pickup Truck","value":269},{"label":"Van / Minivan","value":339}]},{"key":"film","label":"Material","type":"select","default":1.8,"options":[{"label":"Ceramic","value":1.8},{"label":"Regular","value":1}]},{"key":"vlt","label":"Visible light transmission","type":"select","default":5,"options":[{"label":"5%","value":5},{"label":"20%","value":20},{"label":"35%","value":35},{"label":"60%","value":60}]},{"key":"glass_fl","label":"Front left","type":"checkbox","default":1},{"key":"glass_fr","label":"Front right","type":"checkbox","default":1},{"key":"glass_rl","label":"Rear left","type":"checkbox","default":0},{"key":"glass_rr","label":"Rear right","type":"checkbox","default":0},{"key":"glass_back","label":"Back glass","type":"checkbox","default":0},{"key":"glass_strip","label":"Windshield sun strip","type":"checkbox","default":0}],"constants":{"frontRate":0.225,"rearRate":0.2,"backRate":0.15,"stripRate":0.12},"formula":"round(vehicle * film * ((glass_fl + glass_fr) * frontRate + (glass_rl + glass_rr) * rearRate + glass_back * backRate + glass_strip * stripRate))","taxPercent":13,"deposit":{"type":"percent","value":50},"discount":{"type":"percent","value":0},"revision":0,"updateVersion":4},"configured":{"id":"tint-vehicle","name":"Vehicle window tint","path":"/satin/window-tint/vehicle","ruleId":"tint-vehicle","studioProductId":"","active":true,"stock":null,"description":"","artwork":false,"images":[],"templateURL":"","templates":[]},"unavailablePaths":[]}