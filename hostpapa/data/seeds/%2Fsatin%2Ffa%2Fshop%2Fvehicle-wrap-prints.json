{"rule":{"id":"wrap-prints","label":"Vehicle Wrap Prints","path":"/satin/shop/vehicle-wrap-prints","fields":[{"key":"width","label":"Width (inches)","type":"number","default":120,"min":1,"max":1200,"step":0.01},{"key":"height","label":"Height (inches)","type":"number","default":48,"min":1,"max":52,"step":0.01},{"key":"quantity","label":"Quantity","type":"number","default":1,"min":1,"max":10000,"step":1},{"key":"material","label":"Material","type":"select","default":0,"options":[{"label":"3M","value":0},{"label":"Arlon","value":1}]},{"key":"shipping","label":"Delivery","type":"select","default":0,"options":[{"label":"Shop pickup","value":0},{"label":"Next business day shipping · $100","value":100}]},{"key":"design","label":"Design services","type":"checkbox","default":0},{"key":"kind","label":"Print type","type":"select","default":0,"options":[{"label":"Full-colour wrap print","value":0},{"label":"Cut decals · vector artwork required","value":1}]},{"key":"rush","label":"Rush job · +20%","type":"checkbox","default":0}],"constants":{"designFee":250,"printRate":8,"decal3M":12,"decalArlon":10,"rushFactor":0.2},"formula":"(width * height / 144 * quantity * if(kind == 0, printRate, if(material == 0, decal3M, decalArlon)) + shipping + design * designFee) * (1 + rush * rushFactor)","deposit":{"type":"percent","value":100},"discount":{"type":"percent","value":0},"taxPercent":13,"revision":0,"priceOnRequest":false,"updateVersion":4,"priceNote":"Production: 3–4 business days. Shipping transit begins after production. Decals: maximum height 48 in; wrap print: 52 in. Supply artwork at 1:1 scale; decals require vector paths suitable for printing and cutting."},"configured":{"id":"wrap-prints","name":"Vehicle Wrap Prints","path":"/satin/shop/vehicle-wrap-prints","ruleId":"wrap-prints","studioProductId":"","active":true,"stock":null,"description":"","artwork":true,"images":["/satin/img/job-greenlife-van.jpg"],"templateURL":"","templates":[]},"unavailablePaths":[]}