{"rule":{"id":"print-real-estate-signs","label":"Real Estate Signs","path":"/satin/print-shop/large-format/real-estate-signs","fields":[{"key":"quantity","label":"Quantity","type":"number","default":1,"min":1,"max":10000,"step":1},{"key":"size","label":"Size","type":"select","default":0,"options":[{"label":"24 × 32 in","value":0},{"label":"30 × 34 in","value":1},{"label":"32 × 30 in","value":2},{"label":"32 × 36 in","value":3},{"label":"36 × 36 in","value":4}]},{"key":"material","label":"Material","type":"select","default":0,"options":[{"label":"10mm Coroplast","value":0},{"label":"6mm Alumalite (aluminum / corrugated core)","value":1},{"label":"6mm Alupanel (aluminum composite)","value":2}]},{"key":"print_sides","label":"Print sides","type":"select","default":0,"options":[{"label":"Single side","value":0},{"label":"Double side","value":1}]},{"key":"finish","label":"Finish","type":"select","default":0,"options":[{"label":"Standard (no finish)","value":0},{"label":"Lamination · scratch & UV protection","value":1},{"label":"Reflective + lamination","value":2}]},{"key":"full_bleed","label":"Full bleed (print to the edge)","type":"select","default":0,"options":[{"label":"No","value":0},{"label":"Yes","value":1}]},{"key":"grommets","label":"Grommets","type":"select","default":0,"options":[{"label":"Brass (included)","value":0},{"label":"Silver","value":1},{"label":"Black","value":2},{"label":"No holes or grommets","value":3}]},{"key":"design","label":"Design services","type":"checkbox","default":0}],"constants":{"s0":43.99,"s1":50.99,"s2":50.99,"s3":56.99,"s4":59.99,"a0":5.33,"a1":7.08,"a2":6.67,"a3":8,"a4":9,"tier4":0.91,"tier7":0.84,"alumalite":3.5,"alupanel":4.5,"lamination":1.5,"reflective":4,"backSide":12,"designFee":100},"constantLabels":{"s0":"24 × 32 sign · 1–3 pcs","s1":"30 × 34 sign · 1–3 pcs","s2":"32 × 30 sign · 1–3 pcs","s3":"32 × 36 sign · 1–3 pcs","s4":"36 × 36 sign · 1–3 pcs","a0":"24 × 32 area (sq ft)","a1":"30 × 34 area (sq ft)","a2":"32 × 30 area (sq ft)","a3":"32 × 36 area (sq ft)","a4":"36 × 36 area (sq ft)","tier4":"Price factor · 4–6 pcs","tier7":"Price factor · 7+ pcs","alumalite":"Alumalite extra per sq ft","alupanel":"Alupanel extra per sq ft","lamination":"Lamination per sq ft","reflective":"Reflective + lamination per sq ft","backSide":"Double-sided print per sign","designFee":"Design services"},"formula":"quantity * (if(size == 0, s0, if(size == 1, s1, if(size == 2, s2, if(size == 3, s3, s4)))) * if(quantity >= 7, tier7, if(quantity >= 4, tier4, 1)) + if(size == 0, a0, if(size == 1, a1, if(size == 2, a2, if(size == 3, a3, a4)))) * (if(material == 1, alumalite, if(material == 2, alupanel, 0)) + if(finish == 1, lamination, if(finish == 2, reflective, 0))) + print_sides * backSide) + design * designFee","priceNote":"Price per sign. Brass grommets included (2 top, 2 bottom, 1 side). Agent photo added free.","deposit":{"type":"percent","value":100},"discount":{"type":"percent","value":0},"taxPercent":13,"revision":0,"pricingVersion":1,"updateVersion":4},"configured":{"id":"real-estate-signs","name":"Real Estate Signs","path":"/satin/print-shop/large-format/real-estate-signs","ruleId":"print-real-estate-signs","studioProductId":"real-estate-signs","active":true,"stock":null,"description":"","artwork":true,"images":[],"templateURL":"","templates":[]},"unavailablePaths":[]}