{"rule":{"id":"wrap-cargo-van","label":"Ram ProMaster wrap estimator","path":"/satin/vehicle-wraps/estimator/cargo-van","fields":[{"key":"vehicle_0","label":"ProMaster wheelbase","type":"select","default":1,"options":[{"label":"136 in wheelbase","value":1},{"label":"159 in wheelbase","value":1.1}]},{"key":"vehicle_1","label":"Roof height","type":"select","default":1,"options":[{"label":"Low roof","value":1},{"label":"High roof","value":1.12},{"label":"Super high roof","value":1.2}]},{"key":"coverage","label":"Wrap coverage","type":"select","default":1,"options":[{"label":"Decals + Lettering","value":0.22},{"label":"Partial wrap · rear half","value":0.45},{"label":"¾ wrap · rear to front","value":0.7},{"label":"Full Wrap","value":1}]},{"key":"finish","label":"Finish","type":"select","default":1,"options":[{"label":"Gloss","value":1},{"label":"Matte","value":1.12},{"label":"Satin","value":1.12}]},{"key":"material","label":"Material","type":"select","default":1.08,"options":[{"label":"3M","value":1.08}]},{"key":"roof","label":"Include roof","type":"checkbox","default":0},{"key":"design","label":"Design service","type":"checkbox","default":0}],"constants":{"base":4200,"roofMultiplier":1.12,"designDeposit":250,"fullWrapFactor":0.9},"formula":"round((base * vehicle_0 * vehicle_1 * coverage * finish * material * if(roof, roofMultiplier, 1)) * if(coverage == 1, fullWrapFactor, 1) / 10) * 10 + if(design, designDeposit, 0)","deposit":{"type":"percent","value":50},"discount":{"type":"percent","value":0},"taxPercent":13,"revision":0,"updateVersion":4,"priceOnRequest":false},"configured":{"id":"wrap-cargo-van","name":"Ram ProMaster wrap estimator","path":"/satin/vehicle-wraps/estimator/cargo-van","ruleId":"wrap-cargo-van","studioProductId":"vehicle-cargo-van","active":true,"stock":null,"description":"","artwork":false,"images":[],"templateURL":"","templates":[]},"unavailablePaths":[]}